{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/choco_bombs",
      "has": [
        {
          "type": "host",
          "value": "en.tortopani.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/((?!choco_bombs|privacy|offer_en|assets/|en\\.css|cookie-consent\\.js|favicon|apple-touch-icon|robots\\.txt).+)",
      "has": [
        {
          "type": "host",
          "value": "en.tortopani.com"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/thanks",
      "destination": "/api/thanks"
    },
    {
      "source": "/thanks/:product",
      "destination": "/api/thanks?p=:product"
    }
  ],
  "functions": {
    "api/thanks.mjs": {
      "includeFiles": "api/_thanks.html"
    }
  }
}
