{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/((?!choco_bombs|thanks/choco_bombs$|thanks/choco_bombs_gr$|privacy|offer_en|assets/|en\\.css|en-green\\.css|cookie-consent\\.js|favicon|apple-touch-icon|robots\\.txt).+)",
      "has": [
        {
          "type": "host",
          "value": "en.tortopani.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/choco_bombs",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tortopani\\.com$"
        }
      ],
      "destination": "https://en.tortopani.com/choco_bombs",
      "permanent": false
    },
    {
      "source": "/:page(privacy|offer_en|choco_bombs_gr|privacy_gr|offer_en_gr)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tortopani\\.com$"
        }
      ],
      "destination": "https://en.tortopani.com/:page",
      "permanent": false
    },
    {
      "source": "/thanks/:p(choco_bombs|choco_bombs_gr)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tortopani\\.com$"
        }
      ],
      "destination": "https://en.tortopani.com/thanks/:p",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/thanks",
      "destination": "/api/thanks"
    },
    {
      "source": "/thanks/:product",
      "destination": "/api/thanks?p=:product"
    }
  ],
  "functions": {
    "api/thanks.mjs": {
      "includeFiles": "api/_thanks*.html"
    }
  }
}
