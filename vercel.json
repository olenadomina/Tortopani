{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [],
  "rewrites": [
    {
      "source": "/thanks",
      "destination": "/api/thanks"
    },
    {
      "source": "/thanks/:product",
      "destination": "/api/thanks?p=:product"
    }
  ],
  "functions": {
    "api/thanks.mjs": {
      "includeFiles": "api/_thanks.html"
    }
  }
}
