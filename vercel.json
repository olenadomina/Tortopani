{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/choco_bombs",
      "has": [
        {
          "type": "host",
          "value": "en.tortopani.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/((?!choco_bombs|thanks/choco_bombs$|privacy|offer_en|assets/|en\\.css|cookie-consent\\.js|favicon|apple-touch-icon|robots\\.txt).+)",
      "has": [
        {
          "type": "host",
          "value": "en.tortopani.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/choco_bombs",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tortopani\\.com$"
        }
      ],
      "destination": "https://en.tortopani.com/",
      "permanent": false
    },
    {
      "source": "/:page(privacy|offer_en)",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tortopani\\.com$"
        }
      ],
      "destination": "https://en.tortopani.com/:page",
      "permanent": false
    },
    {
      "source": "/thanks/choco_bombs",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tortopani\\.com$"
        }
      ],
      "destination": "https://en.tortopani.com/thanks/choco_bombs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/thanks",
      "destination": "/api/thanks"
    },
    {
      "source": "/thanks/:product",
      "destination": "/api/thanks?p=:product"
    }
  ],
  "functions": {
    "api/thanks.mjs": {
      "includeFiles": "api/_thanks*.html"
    }
  }
}
